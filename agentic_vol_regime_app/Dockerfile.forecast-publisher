FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /app
RUN addgroup --system app && adduser --system --ingroup app app \
    && pip install --no-cache-dir \
        "fastapi>=0.115.0,<1.0.0" \
        "uvicorn[standard]>=0.30.0,<1.0.0" \
        "google-cloud-storage>=2.18.0" \
        "pandas>=2.0.0"

COPY agentic_vol_regime_app/__init__.py agentic_vol_regime_app/_bootstrap.py agentic_vol_regime_app/config.py agentic_vol_regime_app/contracts.py agentic_vol_regime_app/forecast_contract.py agentic_vol_regime_app/forecast_publisher_service.py ./agentic_vol_regime_app/
COPY agentic_vol_regime_app/data/__init__.py agentic_vol_regime_app/data/forecast_gcs.py agentic_vol_regime_app/data/ibkr_client.py agentic_vol_regime_app/data/sector_history_gcs.py agentic_vol_regime_app/data/sector_history_store.py ./agentic_vol_regime_app/data/

USER app
EXPOSE 8080
CMD ["sh", "-c", "uvicorn agentic_vol_regime_app.forecast_publisher_service:create_app --factory --host 0.0.0.0 --port ${PORT}"]
